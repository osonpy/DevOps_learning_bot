BOT_TOKEN=123456:ABC-your-token-from-BotFather

# PostgreSQL. DATABASE_URL docker-compose.yml ichida shulardan yig'iladi (parol bir joyda).
# Kuchli parol:  openssl rand -base64 32
POSTGRES_USER=devops
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=devops_quest

# Faqat Docker'siz lokal ishga tushirishda kerak (compose buni e'tiborsiz qoldiradi):
# DATABASE_URL=sqlite+aiosqlite:///dev.db

DEFAULT_TIMEZONE=Asia/Tashkent
DEFAULT_REMINDER_TIME=09:00
DEFAULT_NUDGE_TIME=21:00

# Necha kun ketma-ket o'tkazilsa jarima yoqiladi ("2 kundan ortiq" = 3)
PENALTY_THRESHOLD=3
# Necha kundan keyin jarima "hardcore" ga aylanadi
HARDCORE_THRESHOLD=5
# Dam olish (review) kuni: 0=Dushanba ... 6=Yakshanba
REST_WEEKDAY=6

# JSON ro'yxat: [123456789]
ADMIN_IDS=[]
